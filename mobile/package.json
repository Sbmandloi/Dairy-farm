{
  "name": "dairy-billing-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "prebuild": "expo prebuild --platform android --clean",
    "clean:bundle": "rm -rf android/app/build/generated/assets/react android/app/build/intermediates/assets android/app/build/intermediates/compressed_assets",
    "apk:debug": "npm run clean:bundle && cd android && ./gradlew assembleDebug",
    "apk:release": "npm run clean:bundle && cd android && ./gradlew assembleRelease",
    "verify:apk": "node scripts/verify-apk.mjs",
    "serve:apk": "node scripts/serve-apk.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "^5.101.4",
    "date-fns": "^4.4.0",
    "expo": "~57.0.9",
    "expo-constants": "~57.0.8",
    "expo-file-system": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-intent-launcher": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.9",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.8",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "typescript": "~6.0.3"
  }
}
