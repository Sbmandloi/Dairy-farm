# Base URL of the Dairy Billing site that serves /api/mobile/*.
#
# This is the ONLY configuration the app needs, and it is inlined at BUILD time
# — so the APK you hand someone is permanently tied to whichever URL was set
# when it was built. Changing it later means rebuilding.
#
# There are two deployed environments, each with its own database and its own
# AUTH_SECRET. A build aimed at one cannot reach the other.
#
#   PROD — the client's real data. This is what ships to the client.
#     EXPO_PUBLIC_API_URL=https://starlit-biscuit-dbe6ae.netlify.app
#
#   DEV — safe to experiment against.
#     EXPO_PUBLIC_API_URL=https://beautiful-sprite-a18e5b.netlify.app
#
#   LOCAL — against `npm run dev` in the parent project. Use your machine's LAN
#   IP, not localhost: on a phone, localhost is the phone itself. Note that this
#   writes to whatever database your local .env points at.
#     EXPO_PUBLIC_API_URL=http://192.168.1.20:3000
#
# HTTPS is required for any non-LAN host — src/config/env.ts refuses to start
# otherwise, because plain HTTP would put the login and every customer record on
# the wire in clear text.
#
# Build and verify in one go:
#   EXPO_PUBLIC_API_URL=https://starlit-biscuit-dbe6ae.netlify.app npm run apk:release
#   npm run verify:apk        # confirms the URL actually compiled in
EXPO_PUBLIC_API_URL=https://starlit-biscuit-dbe6ae.netlify.app
