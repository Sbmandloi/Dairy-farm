# Base URL of the Dairy Billing web app that serves /api/mobile/*.
#
# This is the ONLY configuration the app needs. It is inlined at build time, so
# the APK you hand the client must be built with the production URL set here.
#
# Production (the deployed site):
#   EXPO_PUBLIC_API_URL=https://beautiful-sprite-a18e5b.netlify.app
#
# Local development against `npm run dev` in the parent project — use your
# machine's LAN IP, not localhost: on a phone, localhost is the phone itself.
#   EXPO_PUBLIC_API_URL=http://192.168.1.20:3000
#
# HTTPS is required for any non-local host; see src/config/env.ts.
EXPO_PUBLIC_API_URL=https://your-app.netlify.app
